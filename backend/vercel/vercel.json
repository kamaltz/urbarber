{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/payments/finish", "destination": "/api/payments/return?result=finish" },
    { "source": "/payments/unfinish", "destination": "/api/payments/return?result=unfinish" },
    { "source": "/payments/error", "destination": "/api/payments/return?result=error" },
    { "source": "/api/payments/return", "destination": "/api/payments/return" },
    { "source": "/api/payments/create", "destination": "/api/payments/create" },
    { "source": "/api/payments/sync", "destination": "/api/payments/sync" },
    { "source": "/api/payments/webhook", "destination": "/api/payments/webhook" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/:path*", "destination": "/api/index" }
  ]
}
