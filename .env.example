# Mobile / Expo
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Google Sign-In (native). Required for the "Masuk dengan Google" button to
# work at all -- without it, configureGoogleSignIn() no-ops and the button is
# hidden (isGoogleAuthConfigured() returns false). This is the OAuth 2.0 Web
# client ID (type 3) from Google Cloud Console / Firebase Authentication ->
# Sign-in method -> Google -> Web SDK configuration -- NOT the Android client
# ID. See docs/development/manual-actions.md MA-02 for the full Google
# Sign-In setup checklist (SHA-1/SHA-256 fingerprints, package name, and
# google-services.json requirements).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=