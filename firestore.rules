rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function appRole() {
      return isSignedIn() && request.auth.token != null && 'app_role' in request.auth.token
        ? request.auth.token.app_role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && appRole() == 'admin';
    }

    function isBarber() {
      return isSignedIn() && appRole() == 'barber';
    }

    function isCustomer() {
      return isSignedIn() && appRole() == 'customer';
    }

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. COLLECTION: users
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Customer registration allows creation of own user document with role customer
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer'
        && (request.resource.data.status == 'active' || request.resource.data.status == 'pending_verification');

      // User profile updates for own document: cannot change uid, role, status, or createdAt
      allow update: if (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COLLECTION: customers
    // =========================================================================
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();

      allow create: if isOwner(customerId)
        && (request.resource.data.userId == customerId || request.resource.data.uid == customerId);

      allow update: if (
        isOwner(customerId)
        && (request.resource.data.userId == resource.data.userId || request.resource.data.uid == resource.data.uid)
        && request.resource.data.createdAt == resource.data.createdAt
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. COLLECTION: barbers
    // =========================================================================
    match /barbers/{barberId} {
      // Public read for verified & active barbers; owner or admin can read pending profile
      allow read: if (resource.data.verified == true && resource.data.status == 'active')
        || isOwner(barberId)
        || isAdmin();

      allow create: if isOwner(barberId) || isAdmin();

      // Barber can update editable profile info, but cannot approve verification or modify account status/rating aggregates
      allow update: if (
        isOwner(barberId)
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. COLLECTION: barberServices
    // =========================================================================
    match /barberServices/{serviceId} {
      // Public read active services belonging to barbers
      allow read: if resource.data.active == true || isOwner(resource.data.barberId) || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.barberId == uid()
        && request.resource.data.price >= 0
        && request.resource.data.durationMinutes > 0
        && request.resource.data.name.size() > 0;

      allow update, delete: if isOwner(resource.data.barberId) || isAdmin();
    }

    // =========================================================================
    // 5. COLLECTION: categories
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. COLLECTION: barberSchedules
    // =========================================================================
    match /barberSchedules/{barberId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(barberId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. COLLECTION: bookings
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.customerId)
        || isOwner(resource.data.barberId)
        || isAdmin();

      // Customer creates booking with initial status strictly 'pending'
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.totalPrice >= 0;

      // Status transitions & immutable fields enforcement
      allow update: if (
        // Customer cancellation: pending or accepted -> cancelled
        (
          isOwner(resource.data.customerId)
          && (resource.data.status == 'pending' || resource.data.status == 'accepted')
          && request.resource.data.status == 'cancelled'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
        )
        ||
        // Barber transitions: pending -> accepted / rejected, accepted -> in_progress, in_progress -> completed
        // Barber can process/accept booking ONLY when paymentStatus is 'paid'
        (
          isOwner(resource.data.barberId)
          && 'paymentStatus' in resource.data
          && resource.data.paymentStatus == 'paid'
          && (
            (resource.data.status == 'pending' && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected'))
            || (resource.data.status == 'accepted' && request.resource.data.status == 'in_progress')
            || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed')
          )
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
        )
        ||
        isAdmin()
      );

      // Clients cannot delete booking records
      allow delete: if false;
    }

    // =========================================================================
    // 7b. COLLECTION: payments
    // =========================================================================
    match /payments/{bookingId} {
      // Customer, assigned barber, or admin can read payment record
      allow read: if isOwner(resource.data.customerId)
        || isOwner(resource.data.barberId)
        || isAdmin();

      // Clients CANNOT create, update, or delete payment records directly (Admin SDK only)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 7c. COLLECTION: paymentRequests
    // =========================================================================
    match /paymentRequests/{requestId} {
      // Customer or admin can read payment request idempotency record
      allow read: if isOwner(resource.data.customerId) || isAdmin();

      // Clients CANNOT create, update, or delete payment requests directly (Admin SDK only)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 8. COLLECTION: reviews
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;

      // Customer can create review only for completed booking belonging to themselves with rating 1-5
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == uid();

      allow update: if isOwner(resource.data.barberId) // Barber reply
        || isOwner(resource.data.customerId)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. COLLECTION: favorites
    // =========================================================================
    match /favorites/{favoriteId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.customerId == uid();

      allow delete: if isOwner(resource.data.customerId) || isAdmin();
    }

    // =========================================================================
    // 10. COLLECTION: supportTickets
    // =========================================================================
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.customerId == uid();
      allow update: if isOwner(resource.data.customerId) || isAdmin();

      match /replies/{replyId} {
        allow read: if isOwner(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId) || isAdmin();
        allow create: if isSignedIn();
      }
    }

  }
}
