rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function appRole() {
      return isSignedIn() && request.auth.token != null && 'app_role' in request.auth.token
        ? request.auth.token.app_role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && appRole() == 'admin';
    }

    function isBarber() {
      return isSignedIn() && appRole() == 'barber';
    }

    function isCustomer() {
      return isSignedIn() && appRole() == 'customer';
    }

    // bookingTracking is a realtime client-owned projection, but authorization and
    // lifecycle eligibility always come from the authoritative booking document.
    // Never trust participant IDs copied into the tracking document itself.
    function trackingBookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function isTrackingParticipant(bookingId) {
      return trackingBookingExists(bookingId)
        && (
          (
            isCustomer()
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == uid()
          )
          || (
            isBarber()
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.barberId == uid()
          )
        );
    }

    function isAssignedTrackingBarber(bookingId) {
      return trackingBookingExists(bookingId)
        && isBarber()
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.barberId == uid();
    }

    function isPaidHomeServiceTrackingBooking(bookingId) {
      return trackingBookingExists(bookingId)
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.paymentStatus == 'paid'
        && (
          (
            'serviceLocationType' in get(/databases/$(database)/documents/bookings/$(bookingId)).data
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceLocationType == 'customer_home'
          )
          || (
            'bookingType' in get(/databases/$(database)/documents/bookings/$(bookingId)).data
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.bookingType == 'home'
          )
        );
    }

    function trackingIdentityMatchesBooking(bookingId, data) {
      return data.bookingId == bookingId
        && data.customerId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId
        && data.barberId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.barberId;
    }

    function hasValidTrackingLocation(data) {
      return data.location is map
        && data.location.keys().hasOnly(['latitude', 'longitude'])
        && data.location.latitude is number
        && data.location.latitude >= -90.0
        && data.location.latitude <= 90.0
        && data.location.longitude is number
        && data.location.longitude >= -180.0
        && data.location.longitude <= 180.0;
    }

    function hasValidOptionalTrackingData(data) {
      return (!('accuracy' in data) || data.accuracy == null || data.accuracy is number)
        && (!('heading' in data) || data.heading == null || data.heading is number)
        && (!('speed' in data) || data.speed == null || data.speed is number)
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('arrivedAt' in data) || data.arrivedAt is timestamp)
        && (!('stoppedAt' in data) || data.stoppedAt is timestamp)
        && (!('expiresAt' in data) || data.expiresAt is timestamp);
    }

    function isValidTrackingDocument(data) {
      return data.keys().hasAll([
          'bookingId', 'customerId', 'barberId', 'trackingStatus',
          'isActive', 'location', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'customerId', 'barberId', 'trackingStatus',
          'isActive', 'location', 'accuracy', 'heading', 'speed',
          'startedAt', 'arrivedAt', 'updatedAt', 'stoppedAt', 'expiresAt'
        ])
        && data.bookingId is string
        && data.customerId is string
        && data.barberId is string
        && data.isActive is bool
        && data.updatedAt is timestamp
        && hasValidTrackingLocation(data)
        && hasValidOptionalTrackingData(data)
        && (
          (data.trackingStatus == 'en_route' && data.isActive == true)
          || (data.trackingStatus == 'arrived' && data.isActive == true)
          || (data.trackingStatus == 'stopped' && data.isActive == false)
        );
    }

    function isLegalTrackingTransition() {
      return (
          resource.data.trackingStatus == 'en_route'
          && (
            request.resource.data.trackingStatus == 'en_route'
            || request.resource.data.trackingStatus == 'arrived'
            || request.resource.data.trackingStatus == 'stopped'
          )
        )
        || (
          resource.data.trackingStatus == 'arrived'
          && (
            request.resource.data.trackingStatus == 'arrived'
            || request.resource.data.trackingStatus == 'stopped'
          )
        );
    }

    function trackingBookingStateAllowsWrite(bookingId, trackingStatus) {
      return (
          trackingStatus == 'stopped'
          && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'accepted'
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'in_progress'
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed'
          )
        )
        || (
          (trackingStatus == 'en_route' || trackingStatus == 'arrived')
          && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'accepted'
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'in_progress'
          )
        );
    }

    // Validates a barber-owned location+geohash pair: location must be a map with
    // numeric latitude/longitude within valid Earth bounds, geohash a non-empty string.
    function isValidBarberGeo() {
      return request.resource.data.location is map
        && request.resource.data.location.latitude is number
        && request.resource.data.location.latitude >= -90.0
        && request.resource.data.location.latitude <= 90.0
        && request.resource.data.location.longitude is number
        && request.resource.data.location.longitude >= -180.0
        && request.resource.data.location.longitude <= 180.0
        && request.resource.data.geohash is string
        && request.resource.data.geohash.size() > 0;
    }

    // =========================================================================
    // 1. COLLECTION: users
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Account initialization is backend-only (Admin SDK via trusted Vercel endpoint)
      // Client create is DENIED to prevent unauthorized account creation
      allow create: if false;

      // User profile updates for own document: cannot change uid, role, status, or createdAt
      allow update: if (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COLLECTION: customers
    // =========================================================================
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();

      allow create: if isOwner(customerId)
        && (request.resource.data.userId == customerId || request.resource.data.uid == customerId);

      allow update: if (
        isOwner(customerId)
        && (request.resource.data.userId == resource.data.userId || request.resource.data.uid == resource.data.uid)
        && request.resource.data.createdAt == resource.data.createdAt
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. COLLECTION: barbers
    // =========================================================================
    match /barbers/{barberId} {
      // Public read for barbers so customers can browse & book
      allow read: if true;

      // Barber can only create/update their own profile
      allow create: if isOwner(barberId) && request.resource.data.userId == barberId;

      // Barber can update only their own profile, cannot change authoritative fields.
      // Compares against a shared default (null) rather than gating on field presence, so a
      // barber cannot bypass these guards simply by being the first write to introduce the field.
      allow update: if (
        isOwner(barberId)
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
        && request.resource.data.get('verified', null) == resource.data.get('verified', null)
        // listingStatus is trusted-backend/Admin-authoritative (approve/reject/suspend/
        // reactivate). A Barber's own "open/closed" preference is acceptingNewBookings,
        // which is intentionally NOT in this denylist.
        && request.resource.data.get('listingStatus', null) == resource.data.get('listingStatus', null)
        && request.resource.data.get('ratingAverage', null) == resource.data.get('ratingAverage', null)
        && request.resource.data.get('ratingCount', null) == resource.data.get('ratingCount', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null)
        // location and geohash must be created/changed together, never independently -- a
        // client can never leave stale coordinates paired with a stale geohash (or vice
        // versa). A normal update that touches neither field is unaffected (both sides
        // report "unchanged"). This does not verify the geohash mathematically matches
        // the coordinates, only that both sides of the pair move together.
        && (
          (request.resource.data.get('location', null) != resource.data.get('location', null))
          == (request.resource.data.get('geohash', null) != resource.data.get('geohash', null))
        )
        // If location/geohash are actually changing, the new pair must be within valid
        // Earth bounds and non-empty -- an unrelated update that leaves both untouched
        // is unaffected by this check.
        && (
          request.resource.data.get('location', null) == resource.data.get('location', null)
          || isValidBarberGeo()
        )
        // serviceRadiusKm, when changing, must stay within the app's supported discovery
        // radius range (see src/config/map.config.ts minRadiusKm/maxRadiusKm).
        && (
          request.resource.data.get('serviceRadiusKm', null) == resource.data.get('serviceRadiusKm', null)
          || (
            request.resource.data.serviceRadiusKm is number
            && request.resource.data.serviceRadiusKm >= 1
            && request.resource.data.serviceRadiusKm <= 50
          )
        )
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3b. COLLECTION: barberRegistrations
    // =========================================================================
    match /barberRegistrations/{registrationUid} {
      // Barber can read only their own registration
      allow read: if isOwner(registrationUid) || isAdmin();

      // Barber can create/update only their own registration
      // Cannot change verificationStatus directly (backend-only via Admin SDK)
      allow create: if isOwner(registrationUid);

      allow update: if (
        isOwner(registrationUid)
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. COLLECTION: barberServices
    // =========================================================================
    match /barberServices/{serviceId} {
      // Public read active services belonging to barbers
      allow read: if true;

      // Barber can only create services for themselves
      allow create: if (
        isBarber()
        && request.resource.data.barberId == uid()
      );

      // Barber can only update their own services
      allow update: if (
        isBarber()
        && resource.data.barberId == uid()
        && request.resource.data.barberId == resource.data.barberId
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. COLLECTION: categories
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. COLLECTION: barberSchedules
    // =========================================================================
    match /barberSchedules/{barberId} {
      allow read: if true;
      allow create, update: if isOwner(barberId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. COLLECTION: bookings
    // =========================================================================
    match /bookings/{bookingId} {
      // Customer may read their own booking/payment-intent document regardless of
      // paymentStatus (needed for checkout/payment-status UI). Assigned barber may
      // read ONLY once paymentStatus == 'paid' -- an unpaid payment intent is not
      // yet a booking the barber is entitled to see (payment-first ownership).
      // Admin (backend) read is unrestricted.
      allow read: if (
        isOwner(resource.data.customerId)
        || (
          isOwner(resource.data.barberId)
          && 'paymentStatus' in resource.data
          && resource.data.paymentStatus == 'paid'
        )
        || isAdmin()
      );

      // Scheduled booking creation is trusted-backend-only (Vercel API via Admin SDK,
      // which bypasses these rules). Direct client creation is denied so that slot
      // holds, server-calculated pricing, and payment-first ownership cannot be
      // forged from the client.
      allow create: if false;

      // Status transitions & immutable fields enforcement
      allow update: if (
        // Customer cancellation: pending or accepted -> cancelled
        (
          isOwner(resource.data.customerId)
          && (resource.data.status == 'pending' || resource.data.status == 'accepted')
          && request.resource.data.status == 'cancelled'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
        )
        ||
        // Barber transitions: pending -> accepted / rejected, accepted -> in_progress, in_progress -> completed
        // Batch 08: Barber can process/accept booking ONLY when paymentStatus is 'paid'
        // This enforces payment-first principle: no slot ownership until payment confirmed
        (
          isOwner(resource.data.barberId)
          && 'paymentStatus' in resource.data
          && resource.data.paymentStatus == 'paid'
          && (
            (resource.data.status == 'pending' && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected'))
            || (resource.data.status == 'accepted' && request.resource.data.status == 'in_progress')
            || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed')
          )
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.barberId == resource.data.barberId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
        )
        ||
        isAdmin()
      );

      // Clients cannot delete booking records
      allow delete: if false;
    }

    // =========================================================================
    // 7b. COLLECTION: payments
    // =========================================================================
    // Batch 08: All payment state transitions must occur server-side
    // Clients can only read their own payment records, never write payment state
    match /payments/{bookingId} {
      // Customer, assigned barber, or admin can read payment record
      allow read: if isOwner(resource.data.customerId)
        || isOwner(resource.data.barberId)
        || isAdmin();

      // Clients CANNOT create, update, or delete payment records directly (Admin SDK only)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 7c. COLLECTION: paymentRequests
    // =========================================================================
    match /paymentRequests/{requestId} {
      // Customer or admin can read payment request idempotency record
      allow read: if isOwner(resource.data.customerId) || isAdmin();

      // Clients CANNOT create, update, or delete payment requests directly (Admin SDK only)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 7d. COLLECTION: bookingTracking
    // =========================================================================
    match /bookingTracking/{bookingId} {
      // Direct client access is limited to the assigned customer and assigned
      // barber. Admin tooling uses the Admin SDK; an admin claim alone is not a
      // legitimate reason to expose precise participant location data.
      allow read: if isTrackingParticipant(bookingId);

      // An absent document is the canonical inactive state. Tracking may only be
      // created by the assigned barber for an accepted, paid home-service booking.
      allow create: if isAssignedTrackingBarber(bookingId)
        && isPaidHomeServiceTrackingBooking(bookingId)
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'accepted'
        && trackingIdentityMatchesBooking(bookingId, request.resource.data)
        && isValidTrackingDocument(request.resource.data)
        && request.resource.data.trackingStatus == 'en_route';

      // TrackingStatus is intentionally separate from BookingStatus. Only legal
      // en_route -> arrived -> stopped transitions (plus idempotent/location
      // refreshes) are accepted, and participant identity is immutable.
      allow update: if isAssignedTrackingBarber(bookingId)
        && isPaidHomeServiceTrackingBooking(bookingId)
        && trackingIdentityMatchesBooking(bookingId, request.resource.data)
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.barberId == resource.data.barberId
        && isValidTrackingDocument(request.resource.data)
        && isLegalTrackingTransition()
        && trackingBookingStateAllowsWrite(bookingId, request.resource.data.trackingStatus);

      // Tracking history is never deleted through a client SDK, including admin clients.
      allow delete: if false;
    }

    // =========================================================================
    // 8. COLLECTION: reviews
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;

      // Customer can create review only for their own completed booking with rating 1-5
      // Verified directly against the referenced booking document (not backend-trusted-only,
      // since this is a direct client write)
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookingId is string
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == uid()
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.barberId == request.resource.data.barberId
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed';

      // Customer cannot modify their review after creation; barber can only add/update reply
      allow update: if (
        isOwner(resource.data.barberId)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.barberId == resource.data.barberId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.rating == resource.data.rating
      )
      || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. COLLECTION: favorites
    // =========================================================================
    match /favorites/{favoriteId} {
      // get() must be split from list(): a get() existence-check on a not-yet-created
      // doc has resource == null (customer's first toggle does getDoc() before the
      // doc exists), so it's checked against favoriteId -- the deterministic
      // `{customerId}_{barberId}` path segment -- instead of resource.data.
      allow get: if (isSignedIn() && favoriteId.matches(uid() + '_.*')) || isAdmin();

      // list() queries (e.g. where('customerId','==', uid())) can only be statically
      // proven safe by Firestore when the rule matches resource.data against the
      // same field the query already filters on -- a path-based check here would
      // make every list() query undecidable and get rejected outright.
      allow list: if (isSignedIn() && resource.data.customerId == uid()) || isAdmin();

      allow create: if isSignedIn() && request.resource.data.customerId == uid();

      allow delete: if isOwner(resource.data.customerId) || isAdmin();
    }


    // =========================================================================
    // 9. COLLECTION: conversations (Real-Time Chat)
    // =========================================================================
    match /conversations/{conversationId} {
      // Only participants (customer or barber) can read conversation. Chat is
      // explicitly out of scope for Admin (see docs/agent/business-rules.md:
      // "Admin: No chat access") -- Admin gets no client-level read bypass here.
      allow read: if (
        isOwner(resource.data.customerId)
        || isOwner(resource.data.barberId)
      );

      // Conversation creation stays backend-only (payment-gated, see
      // POST /api/bookings/:bookingId/chat). Deletion stays backend/admin-only.
      allow create, delete: if false;

      // Sending a message (see chat.repository.ts sendMessage) atomically updates
      // conversation metadata -- lastMessage/lastMessageAt/lastSenderId/unread
      // counts -- in the SAME transaction as the message write. Firestore
      // transactions are all-or-nothing, so participants need a real update path
      // here or every real chat send fails. Only metadata may change; every
      // structural/identity field must stay exactly equal to its current value, so
      // this can never be used to add participants, reassign ownership, or reopen a
      // closed conversation.
      //
      // Unread-count ownership: resetUnreadCount only ever zeroes the caller's own
      // field (customerUnreadCount for a customer, barberUnreadCount for a barber);
      // sendMessage only ever increments the RECIPIENT's field. So the other
      // participant's counter may only ever move up (a legitimate incoming-message
      // increment), never down -- a participant resetting/deflating the other
      // side's unread badge is denied, while sendMessage's increment still works.
      allow update: if (
        (isOwner(resource.data.customerId) || isOwner(resource.data.barberId))
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.barberId == resource.data.barberId
        && request.resource.data.bookingId == resource.data.bookingId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !isOwner(resource.data.customerId)
          || request.resource.data.barberUnreadCount >= resource.data.barberUnreadCount
        )
        && (
          !isOwner(resource.data.barberId)
          || request.resource.data.customerUnreadCount >= resource.data.customerUnreadCount
        )
      ) || isAdmin();
    }

    // =========================================================================
    // 9a. COLLECTION: messages (append-only, participant-only)
    // =========================================================================
    match /conversations/{conversationId}/messages/{messageId} {
      // Only participants can read messages (Admin: No chat access -- see the
      // parent conversations match block)
      allow read: if (
        isOwner(get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId)
        || isOwner(get(/databases/$(database)/documents/conversations/$(conversationId)).data.barberId)
      );

      // Only conversation participants can create messages
      allow create: if (
        isSignedIn()
        && request.resource.data.senderId == uid()
        && request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && (
          uid() == get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId
          || uid() == get(/databases/$(database)/documents/conversations/$(conversationId)).data.barberId
        )
      );

      // No updates or deletes allowed (append-only)
      allow update, delete: if false;
    }

    // =========================================================================
    // 10. COLLECTION: supportTickets
    // =========================================================================
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.customerId == uid();
      allow update: if isOwner(resource.data.customerId) || isAdmin();

      match /replies/{replyId} {
        allow read: if isOwner(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId) || isAdmin();
        // Only the ticket owner or admin can add replies
        allow create: if (
          isSignedIn()
          && (
            uid() == get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.customerId
            || isAdmin()
          )
        );
      }
    }

  }
}
