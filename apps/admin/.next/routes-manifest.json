{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/barber-verification/[barberId]",
      "regex": "^/barber\\-verification/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbarberId": "nxtPbarberId"
      },
      "namedRegex": "^/barber\\-verification/(?<nxtPbarberId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/barbers/[barberId]",
      "regex": "^/barbers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbarberId": "nxtPbarberId"
      },
      "namedRegex": "^/barbers/(?<nxtPbarberId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/barber-verification",
      "regex": "^/barber\\-verification(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/barber\\-verification(?:/)?$"
    },
    {
      "page": "/barbers",
      "regex": "^/barbers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/barbers(?:/)?$"
    },
    {
      "page": "/categories",
      "regex": "^/categories(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/categories(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/unauthorized",
      "regex": "^/unauthorized(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/unauthorized(?:/)?$"
    },
    {
      "page": "/users",
      "regex": "^/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/users(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}