# Firebase Client Configuration
# (Only public Web SDK configuration, NO private keys)
# Set these in Vercel under Apps > Admin > Settings > Environment Variables

NEXT_PUBLIC_FIREBASE_API_KEY=<SET_IN_VERCEL>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<SET_IN_VERCEL>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<SET_IN_VERCEL>
NEXT_PUBLIC_FIREBASE_APP_ID=<SET_IN_VERCEL>

# Admin API Base URL
# Points to the trusted backend/vercel deployment
NEXT_PUBLIC_API_BASE_URL=<SET_IN_VERCEL>
